@prefix this: <http://purl.org/nanopub/temp/np001/> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix orcid: <https://orcid.org/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {

  sub:assertion a nt:AssertionTemplate, nt:UnlistedTemplate ;
    rdfs:label "Declaring an MVIKG gene-variant observation" ;
    dct:description "Captures a gene's sequence variant, as modeled by the MVIKG ontology (http://example.org/mvikg#), together with the gene's taxon, and optionally the variant's frequency, the biome the taxon was sampled from, a phenotype the gene is associated with, the variant's name/notation, its Sequence Ontology type, its start coordinate, and supporting evidence text. The core backbone (gene, variant, taxon) is required; everything else is optional, since not every source record fills every field. Statement order follows the ontology's own property order (object properties, then data properties)." ;
    nt:hasNanopubLabelPattern "${variantName}" ;
    nt:hasTag "Biology" ;
    nt:hasTargetNanopubType biolink:SequenceVariant ;
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07, sub:st08,
      sub:st09, sub:st10, sub:st11, sub:st12, sub:st13, sub:st14, sub:st15, sub:st16, sub:st17,
      sub:st18, sub:st19, sub:st20, sub:st21, sub:st22, sub:st23, sub:st24, sub:st25, sub:st26,
      sub:st27 .

  # Statement numbering reflects display order (taxon -> gene -> variant ->
  # variant properties -> phenotype), NOT insertion history. Numbers are
  # zero-padded on purpose: Nanodash lists statements in the sorted order of
  # their node IRIs, and signing re-serializes the assertion in sorted
  # order too (the same gotcha documented for gen:hasViewAction), so
  # unpadded st1/st2/.../st10/... would sort st1, st10, st11, ..., st2, st20,
  # ... -- not numeric order. Renumber (and reorder the hasStatement list
  # and these blocks) together if you ever reorder fields again.

  # ---- taxon ----

  sub:st01 rdf:subject sub:gene ; rdf:predicate biolink:in_taxon ; rdf:object sub:taxon .

  sub:st02 a nt:OptionalStatement ;
    rdf:subject sub:taxon ; rdf:predicate mvikg:has_biome ; rdf:object sub:biome .

  # ---- gene ----

  sub:st03 rdf:subject sub:gene ; rdf:predicate rdf:type ; rdf:object biolink:Gene .
  sub:st04 rdf:subject sub:gene ; rdf:predicate biolink:has_sequence_variant ; rdf:object sub:variant .

  # ---- variant, then variant properties ----

  sub:st05 rdf:subject sub:variant ; rdf:predicate rdf:type ; rdf:object biolink:SequenceVariant .

  # rdfs:label on the variant itself (its short name/notation, e.g. "T77I").
  # Required (not nt:OptionalStatement): this is also the only field that
  # feeds nt:hasNanopubLabelPattern, so without it every variant of a given
  # gene produces an identically-labeled, indistinguishable nanopub in a
  # listing/export.
  sub:st06 rdf:subject sub:variant ; rdf:predicate rdfs:label ; rdf:object sub:variantName .

  # rdf:type on the variant -- its Sequence Ontology classification, in
  # addition to the fixed biolink:SequenceVariant type (st05)
  sub:st07 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate rdf:type ; rdf:object sub:soType .

  sub:st08 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:effect ; rdf:object sub:effect .

  sub:st09 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:length ; rdf:object sub:length .

  sub:st10 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:alt ; rdf:object sub:alt .

  sub:st11 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:ref ; rdf:object sub:ref .

  sub:st12 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate biolink:start_coordinate ; rdf:object sub:startCoordinate .

  sub:st13 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate biolink:end_coordinate ; rdf:object sub:endCoordinate .

  # biolink:has_evidence (object property, nested ECO evidence node) -- grouped: all-or-nothing
  sub:st14 a nt:GroupedStatement, nt:OptionalStatement ;
    nt:hasStatement sub:st15, sub:st16, sub:st17 .

  sub:st15 rdf:subject sub:variant ; rdf:predicate biolink:has_evidence ; rdf:object sub:evidence .
  sub:st16 rdf:subject sub:evidence ; rdf:predicate rdf:type ; rdf:object <http://purl.obolibrary.org/obo/ECO_0000305> .
  sub:st17 rdf:subject sub:evidence ; rdf:predicate dct:description ; rdf:object sub:evidenceText .

  # mvikg:frequency (object property, nested qudt:QuantityValue) — grouped: all-or-nothing
  sub:st18 a nt:GroupedStatement, nt:OptionalStatement ;
    nt:hasStatement sub:st19, sub:st20, sub:st21, sub:st22 .

  sub:st19 rdf:subject sub:variant ; rdf:predicate mvikg:frequency ; rdf:object sub:freq .
  sub:st20 rdf:subject sub:freq ; rdf:predicate rdf:type ; rdf:object qudt:QuantityValue .
  sub:st21 rdf:subject sub:freq ; rdf:predicate qudt:numericValue ; rdf:object sub:freqValue .
  sub:st22 rdf:subject sub:freq ; rdf:predicate qudt:hasUnit ; rdf:object sub:freqUnit .

  # ---- phenotype ----
  # mvikg:comparedTo (data property, on a phenotype associated with the gene) — grouped: all-or-nothing
  sub:st23 a nt:GroupedStatement, nt:OptionalStatement ;
    nt:hasStatement sub:st24, sub:st25, sub:st26, sub:st27 .

  sub:st24 rdf:subject sub:gene ; rdf:predicate biolink:has_phenotype ; rdf:object sub:phenotype .
  sub:st25 rdf:subject sub:phenotype ; rdf:predicate rdf:type ; rdf:object biolink:PhenotypicFeature .

  # rdfs:label on the phenotype itself -- a prose description, not an
  # opaque minted identifier (same rationale as sub:variantName on the
  # variant: this is what a submitter recognizes afterwards, and what
  # Nanodash would otherwise have to render as the bare local-resource IRI).
  # Non-optional *within* the group: if the phenotype group fires at all,
  # it must carry a readable label.
  sub:st26 rdf:subject sub:phenotype ; rdf:predicate rdfs:label ; rdf:object sub:phenotypeDescription .

  sub:st27 rdf:subject sub:phenotype ; rdf:predicate mvikg:comparedTo ; rdf:object sub:comparedTo .

  # ---- placeholder declarations ----

  sub:gene a nt:AgentPlaceholder, nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "the gene this variant and (optionally) phenotype belong to" ;
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/biolink/vocab/Gene" .

  sub:taxon a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "the organism taxon the gene belongs to (NCBITaxon)" ;
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols/api/select?ontology=ncbitaxon&fieldList=iri,label,description&q=" .

  sub:variant a nt:IntroducedResource, nt:LocalResource ;
    rdfs:label "this sequence variant" .

  sub:freq a nt:EmbeddedResource, nt:LocalResource ;
    rdfs:label "the variant's frequency" .

  sub:freqValue a nt:LiteralPlaceholder ;
    nt:hasDatatype xsd:decimal ;
    rdfs:label "frequency value" .

  sub:freqUnit a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    nt:possibleValue unit:PERCENT, unit:UNITLESS ;
    rdfs:label "frequency unit" .

  sub:biome a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "the biome the taxon was sampled from (GOLD biome recommended)" ;
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols4/api/select?ontology=gold&fieldList=iri,label,description&q=" .

  sub:alt a nt:LiteralPlaceholder ;
    rdfs:label "alternate allele" .

  sub:phenotype a nt:EmbeddedResource, nt:LocalResource ;
    rdfs:label "the phenotype associated with this gene" .

  sub:comparedTo a nt:LiteralPlaceholder ;
    rdfs:label "compared to (the baseline/control the phenotype outcome was compared against)" .

  sub:phenotypeDescription a nt:LiteralPlaceholder ;
    rdfs:label "phenotype description (prose, e.g. \"DeltarfaH mutant elicited ROS production...\")" .

  sub:effect a nt:LiteralPlaceholder ;
    rdfs:label "variant effect" .

  sub:length a nt:LiteralPlaceholder ;
    rdfs:label "variant length (free text — not all source rows give a clean integer)" .

  sub:ref a nt:LiteralPlaceholder ;
    rdfs:label "reference allele" .

  sub:variantName a nt:LiteralPlaceholder ;
    rdfs:label "variant name/notation (e.g. T77I)" .

  sub:soType a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "sequence variant type (Sequence Ontology)" ;
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols4/api/select?ontology=so&fieldList=iri,label,description&q=" .

  sub:startCoordinate a nt:LiteralPlaceholder ;
    nt:hasDatatype xsd:integer ;
    rdfs:label "start coordinate (variant position)" .

  sub:endCoordinate a nt:LiteralPlaceholder ;
    nt:hasDatatype xsd:integer ;
    rdfs:label "end coordinate (variant position)" .

  sub:evidence a nt:EmbeddedResource, nt:LocalResource ;
    rdfs:label "evidence for this variant" .

  sub:evidenceText a nt:LiteralPlaceholder ;
    rdfs:label "evidence text (quote/description from the source)" .

  # ---- labels for fixed vocabulary terms used above ----

  rdf:type rdfs:label "is a" .
  biolink:has_sequence_variant rdfs:label "has sequence variant" .
  biolink:in_taxon rdfs:label "in taxon" .
  biolink:has_phenotype rdfs:label "has phenotype" .
  biolink:SequenceVariant rdfs:label "sequence variant" .
  biolink:Gene rdfs:label "gene" .
  biolink:PhenotypicFeature rdfs:label "phenotypic feature" .
  mvikg:frequency rdfs:label "frequency" .
  mvikg:has_biome rdfs:label "has biome" .
  mvikg:alt rdfs:label "alternate allele" .
  mvikg:comparedTo rdfs:label "compared to" .
  mvikg:effect rdfs:label "variant effect" .
  mvikg:length rdfs:label "variant length" .
  mvikg:ref rdfs:label "reference allele" .
  qudt:QuantityValue rdfs:label "quantity value" .
  qudt:numericValue rdfs:label "numeric value" .
  qudt:hasUnit rdfs:label "unit" .
  rdfs:label rdfs:label "label" .
  biolink:start_coordinate rdfs:label "start coordinate" .
  biolink:end_coordinate rdfs:label "end coordinate" .
  biolink:has_evidence rdfs:label "has evidence" .
  dct:description rdfs:label "description" .
  <http://purl.obolibrary.org/obo/ECO_0000305> rdfs:label "evidence" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0000-0000-0000 .
}

sub:pubinfo {
  this: dct:created "2026-11-02T15:35:12Z"^^xsd:dateTime ;
    rdfs:label "Declaring an MVIKG gene-variant observation" ;
    dct:creator orcid:0000-0000-0000-0000 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAgeON_vGgJCt5E4DPMi0eOPaGwNv9tbfFTRZtBwdQL0w> ;
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA-yPZEYODCS39dWOWm7NA_ClOGFHzPi8iYhLzoZf19GI> ;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA4o9JqSxNO2Z47itbAcxvpVfdR97t_7usxmdR90URXQs> .
}
