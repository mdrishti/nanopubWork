@prefix this: <https://w3id.org/np/RAQyDLgiVI123DYaUm18deSAK0mPdsRvuFoTXOm_6GYls> .
@prefix sub: <https://w3id.org/np/RAQyDLgiVI123DYaUm18deSAK0mPdsRvuFoTXOm_6GYls/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix npx: <http://purl.org/nanopub/x/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  mvikg:alt rdfs:label "alternate allele" .
  
  mvikg:comparedTo rdfs:label "compared to" .
  
  mvikg:effect rdfs:label "variant effect" .
  
  mvikg:frequency rdfs:label "frequency" .
  
  mvikg:has_biome rdfs:label "has biome" .
  
  mvikg:length rdfs:label "variant length" .
  
  mvikg:ref rdfs:label "reference allele" .
  
  <http://purl.obolibrary.org/obo/ECO_0000305> rdfs:label "evidence" .
  
  dcmitype:Dataset rdfs:label "dataset" .
  
  dct:description rdfs:label "description" .
  
  dct:isPartOf rdfs:label "is part of" .
  
  qudt:QuantityValue rdfs:label "quantity value" .
  
  qudt:hasUnit rdfs:label "unit" .
  
  qudt:numericValue rdfs:label "numeric value" .
  
  rdf:type rdfs:label "is a" .
  
  rdfs:label rdfs:label "label" .
  
  sosa:isFeatureOfInterestOf rdfs:label "is feature of interest of" .
  
  sosa:isSampleOf rdfs:label "is sample of" .
  
  biolink:Gene rdfs:label "gene" .
  
  biolink:PhenotypicFeature rdfs:label "phenotypic feature" .
  
  biolink:SequenceVariant rdfs:label "sequence variant" .
  
  biolink:has_evidence rdfs:label "has evidence" .
  
  biolink:has_phenotype rdfs:label "has phenotype" .
  
  biolink:has_sequence_variant rdfs:label "has sequence variant" .
  
  biolink:in_taxon rdfs:label "in taxon" .
  
  biolink:start_coordinate rdfs:label "start coordinate" .
  
  sub:alt a nt:LiteralPlaceholder;
    rdfs:label "alternate allele" .
  
  sub:assertion a nt:AssertionTemplate, nt:UnlistedTemplate;
    dct:description "Sosa-faithful counterpart of 'Declaring an MVIKG gene-variant observation': the gene reaches its taxon through the real builder's Sample/Organism layer (gene sosa:isFeatureOfInterestOf sample, sample sosa:isSampleOf organism, organism biolink:in_taxon taxon) instead of a direct gene->taxon edge, and optionally links the sample to its source PMC article/dataset (sample dcterms:isPartOf project). Everything else (variant, frequency, biome, phenotype, SO type, start coordinate, evidence) is identical to the flat template -- kept side by side for comparison, not a replacement.";
    rdfs:label "Declaring an MVIKG gene-variant observation (sosa-faithful)";
    nt:hasNanopubLabelPattern "${variantName}";
    nt:hasStatement sub:evidenceGroup, sub:freqGroup, sub:phenotypeGroup, sub:pmcGroup,
      sub:st1, sub:st10, sub:st11, sub:st12, sub:st13, sub:st14, sub:st15, sub:st16, sub:st17,
      sub:st18, sub:st19, sub:st20, sub:st21, sub:st22, sub:st23, sub:st24, sub:st25, sub:st2a,
      sub:st2b, sub:st2c, sub:st3, sub:st4, sub:st5, sub:st6, sub:st7, sub:st8, sub:st9;
    nt:hasTag "Biology";
    nt:hasTargetNanopubType biolink:SequenceVariant .
  
  sub:biome a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the biome the taxon was sampled from (GOLD biome recommended)";
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols4/api/select?ontology=gold&fieldList=iri,label,description&q=" .
  
  sub:comparedTo a nt:LiteralPlaceholder;
    rdfs:label "compared to (the baseline/control the phenotype outcome was compared against)" .
  
  sub:effect a nt:LiteralPlaceholder;
    rdfs:label "variant effect" .
  
  sub:evidence a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "evidence for this variant" .
  
  sub:evidenceGroup a nt:GroupedStatement, nt:OptionalStatement;
    nt:hasStatement sub:st20, sub:st21, sub:st22 .
  
  sub:evidenceText a nt:LiteralPlaceholder;
    rdfs:label "evidence text (quote/description from the source)" .
  
  sub:freq a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "the variant's frequency" .
  
  sub:freqGroup a nt:GroupedStatement, nt:OptionalStatement;
    nt:hasStatement sub:st5, sub:st6, sub:st7, sub:st8 .
  
  sub:freqUnit a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "frequency unit";
    nt:possibleValue unit:PERCENT, unit:UNITLESS .
  
  sub:freqValue a nt:LiteralPlaceholder;
    rdfs:label "frequency value";
    nt:hasDatatype xsd:decimal .
  
  sub:gene a nt:AgentPlaceholder, nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the gene this variant and (optionally) phenotype belong to";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/biolink/vocab/Gene" .
  
  sub:length a nt:LiteralPlaceholder;
    rdfs:label "variant length (free text — not all source rows give a clean integer)" .
  
  sub:organism a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "the strain/organism this sample was taken from" .
  
  sub:phenotype a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "the phenotype associated with this gene" .
  
  sub:phenotypeDescription a nt:LiteralPlaceholder;
    rdfs:label "phenotype description (prose, e.g. \"DeltarfaH mutant elicited ROS production...\")" .
  
  sub:phenotypeGroup a nt:GroupedStatement, nt:OptionalStatement;
    nt:hasStatement sub:st11, sub:st12, sub:st13, sub:st23 .
  
  sub:pmcGroup a nt:GroupedStatement, nt:OptionalStatement;
    nt:hasStatement sub:st24, sub:st25 .
  
  sub:project a nt:ExternalUriPlaceholder;
    rdfs:label "the PMC article/dataset this record is derived from (PMC URI, e.g. https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3079231/)" .
  
  sub:ref a nt:LiteralPlaceholder;
    rdfs:label "reference allele" .
  
  sub:sample a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "the sample this gene was observed in" .
  
  sub:soType a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "sequence variant type (Sequence Ontology)";
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols4/api/select?ontology=so&fieldList=iri,label,description&q=" .
  
  sub:st1 rdf:object biolink:Gene;
    rdf:predicate rdf:type;
    rdf:subject sub:gene .
  
  sub:st10 a nt:OptionalStatement;
    rdf:object sub:alt;
    rdf:predicate mvikg:alt;
    rdf:subject sub:variant .
  
  sub:st11 rdf:object sub:phenotype;
    rdf:predicate biolink:has_phenotype;
    rdf:subject sub:gene .
  
  sub:st12 rdf:object biolink:PhenotypicFeature;
    rdf:predicate rdf:type;
    rdf:subject sub:phenotype .
  
  sub:st13 rdf:object sub:comparedTo;
    rdf:predicate mvikg:comparedTo;
    rdf:subject sub:phenotype .
  
  sub:st14 a nt:OptionalStatement;
    rdf:object sub:effect;
    rdf:predicate mvikg:effect;
    rdf:subject sub:variant .
  
  sub:st15 a nt:OptionalStatement;
    rdf:object sub:length;
    rdf:predicate mvikg:length;
    rdf:subject sub:variant .
  
  sub:st16 a nt:OptionalStatement;
    rdf:object sub:ref;
    rdf:predicate mvikg:ref;
    rdf:subject sub:variant .
  
  sub:st17 rdf:object sub:variantName;
    rdf:predicate rdfs:label;
    rdf:subject sub:variant .
  
  sub:st18 a nt:OptionalStatement;
    rdf:object sub:soType;
    rdf:predicate rdf:type;
    rdf:subject sub:variant .
  
  sub:st19 a nt:OptionalStatement;
    rdf:object sub:startCoordinate;
    rdf:predicate biolink:start_coordinate;
    rdf:subject sub:variant .
  
  sub:st20 rdf:object sub:evidence;
    rdf:predicate biolink:has_evidence;
    rdf:subject sub:variant .
  
  sub:st21 rdf:object <http://purl.obolibrary.org/obo/ECO_0000305>;
    rdf:predicate rdf:type;
    rdf:subject sub:evidence .
  
  sub:st22 rdf:object sub:evidenceText;
    rdf:predicate dct:description;
    rdf:subject sub:evidence .
  
  sub:st23 rdf:object sub:phenotypeDescription;
    rdf:predicate rdfs:label;
    rdf:subject sub:phenotype .
  
  sub:st24 rdf:object sub:project;
    rdf:predicate dct:isPartOf;
    rdf:subject sub:sample .
  
  sub:st25 rdf:object dcmitype:Dataset;
    rdf:predicate rdf:type;
    rdf:subject sub:project .
  
  sub:st2a rdf:object sub:sample;
    rdf:predicate sosa:isFeatureOfInterestOf;
    rdf:subject sub:gene .
  
  sub:st2b rdf:object sub:organism;
    rdf:predicate sosa:isSampleOf;
    rdf:subject sub:sample .
  
  sub:st2c rdf:object sub:taxon;
    rdf:predicate biolink:in_taxon;
    rdf:subject sub:organism .
  
  sub:st3 rdf:object sub:variant;
    rdf:predicate biolink:has_sequence_variant;
    rdf:subject sub:gene .
  
  sub:st4 rdf:object biolink:SequenceVariant;
    rdf:predicate rdf:type;
    rdf:subject sub:variant .
  
  sub:st5 rdf:object sub:freq;
    rdf:predicate mvikg:frequency;
    rdf:subject sub:variant .
  
  sub:st6 rdf:object qudt:QuantityValue;
    rdf:predicate rdf:type;
    rdf:subject sub:freq .
  
  sub:st7 rdf:object sub:freqValue;
    rdf:predicate qudt:numericValue;
    rdf:subject sub:freq .
  
  sub:st8 rdf:object sub:freqUnit;
    rdf:predicate qudt:hasUnit;
    rdf:subject sub:freq .
  
  sub:st9 a nt:OptionalStatement;
    rdf:object sub:biome;
    rdf:predicate mvikg:has_biome;
    rdf:subject sub:taxon .
  
  sub:startCoordinate a nt:LiteralPlaceholder;
    rdfs:label "start coordinate (variant position)";
    nt:hasDatatype xsd:integer .
  
  sub:taxon a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the organism taxon the strain belongs to (NCBITaxon)";
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols/api/select?ontology=ncbitaxon&fieldList=iri,label,description&q=" .
  
  sub:variant a nt:IntroducedResource, nt:LocalResource;
    rdfs:label "this sequence variant" .
  
  sub:variantName a nt:LiteralPlaceholder;
    rdfs:label "variant name/notation (e.g. T77I)" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0000-0000-0000 .
}

sub:pubinfo {
  this: dct:created "2026-11-03T13:45:00Z"^^xsd:dateTime;
    dct:creator orcid:0000-0000-0000-0000;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    rdfs:label "Declaring an MVIKG gene-variant observation (sosa-faithful)";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA-yPZEYODCS39dWOWm7NA_ClOGFHzPi8iYhLzoZf19GI>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA4o9JqSxNO2Z47itbAcxvpVfdR97t_7usxmdR90URXQs>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAgeON_vGgJCt5E4DPMi0eOPaGwNv9tbfFTRZtBwdQL0w> .
  
  sub:sig npx:hasAlgorithm "RSA";
    npx:hasPublicKey "";
    npx:hasSignature "";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0000-0000-0000 .
}
