@prefix this: <http://purl.org/nanopub/temp/np002/> .
@prefix sub: <http://purl.org/nanopub/temp/np002/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix bl: <https://w3id.org/biolink/vocab/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:template a nt:AssertionTemplate ;
    rdfs:label "Declaring a sequence variant (mutation) of a gene (MVIKG)" ;
    dct:description "Records a sequence variant (mutation) called against a gene, with its reference/alternate alleles, effect, length and observed frequency, and optionally the phenotype it is associated with, per the MVIKG ontology (mutation-side data: bl:SequenceVariant, mvikg:ref, mvikg:alt, mvikg:effect, mvikg:length, mvikg:frequency)." ;
    nt:hasStatement sub:st1, sub:st2, sub:st3, sub:st4, sub:st5, sub:st6, sub:st7, sub:st8, sub:st9, sub:st10 .

  sub:variant a nt:LocalResource ;
    rdfs:label "sequence variant" .

  sub:quantity a nt:LocalResource ;
    rdfs:label "variant frequency value" .

  sub:gene a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "gene affected by the variant (e.g. an Ensembl gene IRI)" ;
    nt:possibleValuesFromApi "https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=5&search=" .

  sub:ref a nt:LiteralPlaceholder ;
    nt:hasRegex "[ACGTNacgtn.-]*" ;
    rdfs:label "reference allele" .

  sub:alt a nt:LiteralPlaceholder ;
    nt:hasRegex "[ACGTNacgtn.-]*" ;
    rdfs:label "alternate allele" .

  sub:effect a nt:LiteralPlaceholder ;
    rdfs:label "variant effect (e.g. missense_variant)" .

  sub:length a nt:LiteralPlaceholder ;
    rdfs:label "variant length" .

  sub:freqvalue a nt:LiteralPlaceholder ;
    nt:hasDatatype xsd:decimal ;
    rdfs:label "observed frequency (numeric value)" .

  sub:frequnit a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "frequency unit (e.g. qudt:Percent)" ;
    nt:hasDefaultValue <http://qudt.org/vocab/unit/PERCENT> .

  sub:phenotype a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "associated phenotype" ;
    nt:possibleValuesFromApi "https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=5&search=" .

  sub:st1 rdf:subject sub:variant ; rdf:predicate rdf:type ; rdf:object bl:SequenceVariant .
  sub:st2 rdf:subject sub:variant ; rdf:predicate bl:is_sequence_variant_of ; rdf:object sub:gene .
  sub:st3 rdf:subject sub:variant ; rdf:predicate mvikg:ref ; rdf:object sub:ref .
  sub:st4 rdf:subject sub:variant ; rdf:predicate mvikg:alt ; rdf:object sub:alt .

  sub:st5 rdf:subject sub:variant ; rdf:predicate mvikg:effect ; rdf:object sub:effect .
  sub:st5 nt:optStatement "true"^^xsd:boolean .

  sub:st6 rdf:subject sub:variant ; rdf:predicate mvikg:length ; rdf:object sub:length .
  sub:st6 nt:optStatement "true"^^xsd:boolean .

  sub:st7 rdf:subject sub:variant ; rdf:predicate mvikg:frequency ; rdf:object sub:quantity .
  sub:st7 nt:optStatement "true"^^xsd:boolean .

  sub:st8 rdf:subject sub:quantity ; rdf:predicate qudt:numericValue ; rdf:object sub:freqvalue .
  sub:st8 nt:optStatement "true"^^xsd:boolean .

  sub:st9 rdf:subject sub:quantity ; rdf:predicate qudt:unit ; rdf:object sub:frequnit .
  sub:st9 nt:optStatement "true"^^xsd:boolean .

  sub:st10 rdf:subject sub:variant ; rdf:predicate bl:has_phenotype ; rdf:object sub:phenotype .
  sub:st10 nt:optStatement "true"^^xsd:boolean .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:USER-ORCID .
}

sub:pubinfo {
  this: dct:created "2026-11-02T12:37:43Z"^^xsd:dateTime ;
    rdfs:label "Declaring a sequence variant (mutation) of a gene (MVIKG)" ;
    dct:creator orcid:USER-ORCID ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:introduces sub:template .
}
