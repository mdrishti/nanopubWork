@prefix this: <http://purl.org/nanopub/temp/np001/> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix orcid: <https://orcid.org/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {

  sub:templateVersion a nt:AssertionTemplate, nt:UnlistedTemplate ;
    dct:isVersionOf <https://w3id.org/np/RATaU30_DTYcbG3bqZQb4fLRktnxKyjASwI5fFFIumAeo/template> ;
    gen:governedBy <https://w3id.org/spaces/mvikg> ;
    rdfs:label "Declaring an MVIKG observation" ;
    dct:description "Declaring an MVIKG observation";
    nt:hasNanopubLabelPattern "${variantName}" ;
    nt:hasTag "Biology" ;
    nt:hasTargetNanopubType biolink:SequenceVariant ;
    nt:hasStatement sub:st01, sub:st02, sub:st08,
      sub:st09, sub:st10, sub:st11, sub:st12, sub:st13, sub:st14, sub:st15, sub:st16, sub:st17,
      sub:st18, sub:st19, sub:st20, sub:st23, sub:st24 .

  # Statement numbering reflects display order (sample -> gene -> variant ->
  # variant properties), NOT insertion history. Numbers are zero-padded on
  # purpose: Nanodash lists statements in the sorted order of their node
  # IRIs, and signing re-serializes the assertion in sorted order too (the
  # same gotcha documented for gen:hasViewAction), so unpadded
  # st1/st2/.../st10/... would not sort in numeric order. Renumber (and
  # reorder the hasStatement list and these blocks) together if you ever
  # reorder fields again. Numbers are kept non-contiguous on purpose where
  # statements were removed in this version (phenotype, frequency/evidence
  # object-property nodes), so the diff against the superseded version
  # stays legible -- st03-07, st21-22, st27-32 are retired, not reused.
  #
  # st02-st07 (sample/organism/taxon/biome/PMC-project) were split out into
  # a separate template, mvikg-sample-taxon-template-sosa.trig: this
  # template now only *references* an already-declared sample node via the
  # sub:sample lookup placeholder below, instead of minting one.
  #
  # Phenotype was split out into its own template,
  # mvikg-phenotype-template-sosa.trig, so that many phenotype
  # observations can reference the same variant and/or sample. See that
  # template for the biolink:has_phenotype replacement
  # (mvikg:isAssociatedWithVariant / sosa:isResultOf).
  #
  # Frequency and evidence no longer mint their own embedded
  # qudt:QuantityValue / ECO nodes -- this template introduces exactly one
  # resource (sub:variant), per the one-introduced-resource-per-template
  # rule now applied across all MVIKG templates. Both are flattened to
  # direct literal properties on sub:variant.

  # ---- sample (declared by mvikg-sample-taxon-template-sosa.trig) ----

  sub:st01 rdf:subject sub:gene ; rdf:predicate sosa:isFeatureOfInterestOf ; rdf:object sub:sample .

  # ---- governing space (every MVIKG-introduced resource belongs to the mvikg KG) ----

  sub:st02 rdf:subject sub:variant ; rdf:predicate dct:isPartOf ; rdf:object <https://w3id.org/spaces/mvikg/r/kg> .

  # ---- gene ----

  sub:st08 rdf:subject sub:gene ; rdf:predicate rdf:type ; rdf:object biolink:Gene .
  sub:st09 rdf:subject sub:gene ; rdf:predicate biolink:has_sequence_variant ; rdf:object sub:variant .

  # ---- variant, then variant properties ----

  sub:st10 rdf:subject sub:variant ; rdf:predicate rdf:type ; rdf:object biolink:SequenceVariant .

  # rdfs:label on the variant itself (its short name/notation, e.g. "T77I").
  # Required: also the only field feeding nt:hasNanopubLabelPattern.
  sub:st11 rdf:subject sub:variant ; rdf:predicate rdfs:label ; rdf:object sub:variantName .

  # rdf:type on the variant -- its Sequence Ontology classification, in
  # addition to the fixed biolink:SequenceVariant type (st10)
  sub:st12 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate rdf:type ; rdf:object sub:soType .

  sub:st13 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:effect ; rdf:object sub:effect .

  sub:st14 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:length ; rdf:object sub:length .

  sub:st15 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:alt ; rdf:object sub:alt .

  sub:st16 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:ref ; rdf:object sub:ref .

  sub:st17 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate biolink:start_coordinate ; rdf:object sub:startCoordinate .

  sub:st18 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate biolink:end_coordinate ; rdf:object sub:endCoordinate .

  # evidence text -- flattened from the dropped embedded ECO evidence node
  # (rdf:type ECO_0000305 + dct:description) to a single literal directly
  # on the variant.
  sub:st19 a nt:OptionalStatement ;
    rdf:subject sub:variant ; rdf:predicate mvikg:evidenceText ; rdf:object sub:evidenceText .

  # mvikg:frequencyValue + mvikg:frequencyUnit -- flat literal/IRI
  # properties directly on sub:variant (no intermediate quantity node:
  # this template introduces exactly one resource). Kept grouped:
  # all-or-nothing, since a bare value with no unit (or vice versa) is not
  # meaningful.
  sub:st20 a nt:GroupedStatement, nt:OptionalStatement ;
    nt:hasStatement sub:st23, sub:st24 .

  sub:st23 rdf:subject sub:variant ; rdf:predicate mvikg:frequencyValue ; rdf:object sub:freqValue .
  sub:st24 rdf:subject sub:variant ; rdf:predicate mvikg:frequencyUnit ; rdf:object sub:freqUnit .

  # ---- relocated to mvikg-phenotype-template-sosa.trig: biolink:has_phenotype,
  # the phenotype node, its rdfs:label and mvikg:comparedTo ----

  # ---- placeholder declarations ----

  sub:gene a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "the gene this variant belongs to (search existing genes, or enter an NCBI Gene ID)" ;
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/biolink/vocab/Gene",
      "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=gene&retmode=json&id=" .

  sub:sample a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "the sample this gene was observed in (declared via the sample-context template)" ;
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=http://www.w3.org/ns/sosa/Sample" .

  sub:variant a nt:IntroducedResource, nt:LocalResource ;
    rdfs:label "this sequence variant" .

  sub:freqValue a nt:LiteralPlaceholder ;
    nt:hasDatatype xsd:decimal ;
    rdfs:label "frequency value" .

  sub:freqUnit a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    nt:possibleValue unit:PERCENT, unit:UNITLESS ;
    rdfs:label "frequency unit" .

  sub:alt a nt:LiteralPlaceholder ;
    rdfs:label "alternate allele" .

  sub:effect a nt:LiteralPlaceholder ;
    rdfs:label "variant effect" .

  sub:length a nt:LiteralPlaceholder ;
    rdfs:label "variant length (free text — not all source rows give a clean integer)" .

  sub:ref a nt:LiteralPlaceholder ;
    rdfs:label "reference allele" .

  sub:variantName a nt:LiteralPlaceholder ;
    rdfs:label "variant name/notation (e.g. T77I)" .

  sub:soType a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder ;
    rdfs:label "sequence variant type (Sequence Ontology)" ;
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols4/api/select?ontology=so&fieldList=iri,label,description&q=" .

  sub:startCoordinate a nt:LiteralPlaceholder ;
    nt:hasDatatype xsd:integer ;
    rdfs:label "start coordinate (variant position)" .

  sub:endCoordinate a nt:LiteralPlaceholder ;
    nt:hasDatatype xsd:integer ;
    rdfs:label "end coordinate (variant position)" .

  sub:evidenceText a nt:LiteralPlaceholder ;
    rdfs:label "evidence text (quote/description from the source)" .

  # ---- labels for fixed vocabulary terms used above ----

  rdf:type rdfs:label "is a" .
  biolink:has_sequence_variant rdfs:label "has sequence variant" .
  biolink:SequenceVariant rdfs:label "sequence variant" .
  biolink:Gene rdfs:label "gene" .
  mvikg:frequencyValue rdfs:label "frequency value" .
  mvikg:frequencyUnit rdfs:label "frequency unit" .
  mvikg:alt rdfs:label "alternate allele" .
  mvikg:effect rdfs:label "variant effect" .
  mvikg:length rdfs:label "variant length" .
  mvikg:ref rdfs:label "reference allele" .
  mvikg:evidenceText rdfs:label "evidence text" .
  rdfs:label rdfs:label "label" .
  biolink:start_coordinate rdfs:label "start coordinate" .
  biolink:end_coordinate rdfs:label "end coordinate" .
  dct:isPartOf rdfs:label "is part of" .
  sosa:isFeatureOfInterestOf rdfs:label "is feature of interest of" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0009-0005-5515-1230 .
}

sub:pubinfo {
  this: dct:created "2026-11-06T12:48:58Z"^^xsd:dateTime ;
    rdfs:label "Declaring an MVIKG observation" ;
    dct:creator orcid:0009-0005-5515-1230 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:embeds sub:templateVersion ;
    npx:introduces <https://w3id.org/np/RATaU30_DTYcbG3bqZQb4fLRktnxKyjASwI5fFFIumAeo/template> ;
    npx:supersedes <https://w3id.org/np/RATaU30_DTYcbG3bqZQb4fLRktnxKyjASwI5fFFIumAeo> ;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAgeON_vGgJCt5E4DPMi0eOPaGwNv9tbfFTRZtBwdQL0w> ;
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA-yPZEYODCS39dWOWm7NA_ClOGFHzPi8iYhLzoZf19GI> ;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA4o9JqSxNO2Z47itbAcxvpVfdR97t_7usxmdR90URXQs> .
}
