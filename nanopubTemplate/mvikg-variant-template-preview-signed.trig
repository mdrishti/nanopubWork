@prefix this: <https://w3id.org/np/RAM_t9EYwYdN7qAyVUZYZnHTNO_RmDLDZ3vLoT3wcKOIQ> .
@prefix sub: <https://w3id.org/np/RAM_t9EYwYdN7qAyVUZYZnHTNO_RmDLDZ3vLoT3wcKOIQ/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix mvikg: <http://example.org/mvikg/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix npx: <http://purl.org/nanopub/x/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  mvikg:alt rdfs:label "alternate allele" .
  
  mvikg:comparedTo rdfs:label "compared to" .
  
  mvikg:effect rdfs:label "variant effect" .
  
  mvikg:frequency rdfs:label "frequency" .
  
  mvikg:has_biome rdfs:label "has biome" .
  
  mvikg:length rdfs:label "variant length" .
  
  mvikg:ref rdfs:label "reference allele" .
  
  qudt:QuantityValue rdfs:label "quantity value" .
  
  qudt:hasUnit rdfs:label "unit" .
  
  qudt:numericValue rdfs:label "numeric value" .
  
  rdf:type rdfs:label "is a" .
  
  biolink:Gene rdfs:label "gene" .
  
  biolink:PhenotypicFeature rdfs:label "phenotypic feature" .
  
  biolink:SequenceVariant rdfs:label "sequence variant" .
  
  biolink:has_phenotype rdfs:label "has phenotype" .
  
  biolink:has_sequence_variant rdfs:label "has sequence variant" .
  
  biolink:in_taxon rdfs:label "in taxon" .
  
  sub:alt a nt:LiteralPlaceholder;
    rdfs:label "alternate allele" .
  
  sub:assertion a nt:AssertionTemplate, nt:UnlistedTemplate;
    dct:description "Captures a gene's sequence variant, as modeled by the MVIKG ontology (http://example.org/mvikg#), together with the gene's taxon, and optionally the variant's frequency, the biome the taxon was sampled from, and a phenotype the gene is associated with. The core backbone (gene, variant, taxon) is required; everything else is optional, since not every source record fills every field. Statement order follows the ontology's own property order (object properties, then data properties).";
    rdfs:label "Declaring an MVIKG gene-variant observation";
    nt:hasNanopubLabelPattern "Sequence variant of ${gene}";
    nt:hasStatement sub:freqGroup, sub:phenotypeGroup, sub:st1, sub:st10, sub:st11, sub:st12,
      sub:st13, sub:st14, sub:st15, sub:st16, sub:st2, sub:st3, sub:st4, sub:st5, sub:st6,
      sub:st7, sub:st8, sub:st9;
    nt:hasTag "Biology";
    nt:hasTargetNanopubType biolink:SequenceVariant .
  
  sub:biome a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the biome the taxon was sampled from (GOLD biome recommended)";
    nt:possibleValuesFromApi "https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=5&search=" .
  
  sub:comparedTo a nt:LiteralPlaceholder;
    rdfs:label "compared to (the baseline/control the phenotype outcome was compared against)" .
  
  sub:effect a nt:LiteralPlaceholder;
    rdfs:label "variant effect" .
  
  sub:freq a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "the variant's frequency" .
  
  sub:freqGroup a nt:GroupedStatement, nt:OptionalStatement;
    nt:hasStatement sub:st5, sub:st6, sub:st7, sub:st8 .
  
  sub:freqUnit a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "frequency unit";
    nt:possibleValue unit:PERCENT, unit:UNITLESS .
  
  sub:freqValue a nt:LiteralPlaceholder;
    rdfs:label "frequency value";
    nt:hasDatatype xsd:decimal .
  
  sub:gene a nt:AgentPlaceholder, nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the gene this variant and (optionally) phenotype belong to";
    nt:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAom4OoQ8U2K6A629YRXKo9-XU-ZJM7-KZs1h11OD6c1w/find-things?type=https://w3id.org/biolink/vocab/Gene" .
  
  sub:length a nt:LiteralPlaceholder;
    rdfs:label "variant length (free text — not all source rows give a clean integer)" .
  
  sub:phenotype a nt:EmbeddedResource, nt:LocalResource;
    rdfs:label "the phenotype associated with this gene" .
  
  sub:phenotypeGroup a nt:GroupedStatement, nt:OptionalStatement;
    nt:hasStatement sub:st11, sub:st12, sub:st13 .
  
  sub:ref a nt:LiteralPlaceholder;
    rdfs:label "reference allele" .
  
  sub:st1 rdf:object biolink:Gene;
    rdf:predicate rdf:type;
    rdf:subject sub:gene .
  
  sub:st10 a nt:OptionalStatement;
    rdf:object sub:alt;
    rdf:predicate mvikg:alt;
    rdf:subject sub:variant .
  
  sub:st11 rdf:object sub:phenotype;
    rdf:predicate biolink:has_phenotype;
    rdf:subject sub:gene .
  
  sub:st12 rdf:object biolink:PhenotypicFeature;
    rdf:predicate rdf:type;
    rdf:subject sub:phenotype .
  
  sub:st13 rdf:object sub:comparedTo;
    rdf:predicate mvikg:comparedTo;
    rdf:subject sub:phenotype .
  
  sub:st14 a nt:OptionalStatement;
    rdf:object sub:effect;
    rdf:predicate mvikg:effect;
    rdf:subject sub:variant .
  
  sub:st15 a nt:OptionalStatement;
    rdf:object sub:length;
    rdf:predicate mvikg:length;
    rdf:subject sub:variant .
  
  sub:st16 a nt:OptionalStatement;
    rdf:object sub:ref;
    rdf:predicate mvikg:ref;
    rdf:subject sub:variant .
  
  sub:st2 rdf:object sub:taxon;
    rdf:predicate biolink:in_taxon;
    rdf:subject sub:gene .
  
  sub:st3 rdf:object sub:variant;
    rdf:predicate biolink:has_sequence_variant;
    rdf:subject sub:gene .
  
  sub:st4 rdf:object biolink:SequenceVariant;
    rdf:predicate rdf:type;
    rdf:subject sub:variant .
  
  sub:st5 rdf:object sub:freq;
    rdf:predicate mvikg:frequency;
    rdf:subject sub:variant .
  
  sub:st6 rdf:object qudt:QuantityValue;
    rdf:predicate rdf:type;
    rdf:subject sub:freq .
  
  sub:st7 rdf:object sub:freqValue;
    rdf:predicate qudt:numericValue;
    rdf:subject sub:freq .
  
  sub:st8 rdf:object sub:freqUnit;
    rdf:predicate qudt:hasUnit;
    rdf:subject sub:freq .
  
  sub:st9 a nt:OptionalStatement;
    rdf:object sub:biome;
    rdf:predicate mvikg:has_biome;
    rdf:subject sub:taxon .
  
  sub:taxon a nt:ExternalUriPlaceholder, nt:GuidedChoicePlaceholder;
    rdfs:label "the organism taxon the gene belongs to (NCBITaxon)";
    nt:possibleValuesFromApi "https://www.ebi.ac.uk/ols/api/select?ontology=ncbitaxon&fieldList=iri,label,description&q=" .
  
  sub:variant a nt:IntroducedResource, nt:LocalResource;
    rdfs:label "this sequence variant" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0000-0000-0000 .
}

sub:pubinfo {
  this: dct:created "2026-11-02T15:35:12Z"^^xsd:dateTime;
    dct:creator orcid:0000-0000-0000-0000;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    rdfs:label "Declaring an MVIKG gene-variant observation";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA-yPZEYODCS39dWOWm7NA_ClOGFHzPi8iYhLzoZf19GI>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA4o9JqSxNO2Z47itbAcxvpVfdR97t_7usxmdR90URXQs>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAgeON_vGgJCt5E4DPMi0eOPaGwNv9tbfFTRZtBwdQL0w> .
  
  sub:sig npx:hasAlgorithm "RSA";
    npx:hasPublicKey "";
    npx:hasSignature "";
    npx:hasSignatureTarget this:;
    npx:signedBy orcid:0000-0000-0000-0000 .
}
