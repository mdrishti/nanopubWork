    <!-- https://w3id.org/biolink/vocab/related_to_at_instance_level -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/related_to_at_instance_level">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label>related to at instance level</rdfs:label>
        <skos:definition>Represents a relationship held between two instances of a data classes.  Much like an assertion component, in an ABox, these represent facts associated with the conceptual model.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <vocab:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</vocab:canonical_predicate>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/taxon_of -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/taxon_of">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/OrganismTaxon"/>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/ThingWithTaxon"/>
        <rdfs:label>taxon of</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/linkml/mixins -->


    <owl:ObjectProperty rdf:about="https://w3id.org/linkml/mixins"/>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->





    <!-- http://example.org/mvikg/alt -->


    <owl:DatatypeProperty rdf:about="http://example.org/mvikg/alt">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>alternate allele</rdfs:label>
        <skos:definition>The alternate (variant) allele observed at a given sequence position.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl.</skos:note>
    </owl:DatatypeProperty>



    <!-- http://example.org/mvikg/comparedTo -->


    <owl:DatatypeProperty rdf:about="http://example.org/mvikg/comparedTo">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/PhenotypicFeature"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>compared to</rdfs:label>
        <skos:definition>A free-text description of the baseline or control a phenotype outcome was compared against.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Free-text description of the baseline/control a phenotype outcome was compared against. Domain (biolink:PhenotypicFeature) is external — see mvikg-restrictions.ttl.</skos:note>
    </owl:DatatypeProperty>



    <!-- http://example.org/mvikg/effect -->


    <owl:DatatypeProperty rdf:about="http://example.org/mvikg/effect">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>variant effect</rdfs:label>
        <skos:definition>A free-text description of the functional effect of a sequence variant, as reported in the source.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl.</skos:note>
    </owl:DatatypeProperty>



    <!-- http://example.org/mvikg/frequencyValue -->


    <owl:DatatypeProperty rdf:about="http://example.org/mvikg/frequencyValue">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>frequency value</rdfs:label>
        <skos:definition>The numeric frequency value of a sequence variant or allele within a population; interpreted together with mvikg:frequencyUnit.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl.</skos:note>
    </owl:DatatypeProperty>



    <!-- http://example.org/mvikg/has_biome_text -->


    <owl:DatatypeProperty rdf:about="http://example.org/mvikg/has_biome_text">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/OrganismTaxon"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has_biome_text</rdfs:label>
        <skos:definition>Free-text description of a sample or organism taxon&apos;s environmental biome, used when the source text could not be mapped to a controlled GOLD biome term. If a value was normalized into mvikg:has_biome_term, the original text should still be retained here for provenance.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Dual-predicate split of the former single-valued mvikg:has_biome, per the Case A (IRI-or-free-text) pattern.</skos:note>
    </owl:DatatypeProperty>



    <!-- http://example.org/mvikg/length -->


    <owl:DatatypeProperty rdf:about="http://example.org/mvikg/length">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>variant length</rdfs:label>
        <skos:definition>The length of a sequence variant.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl.</skos:note>
        <skos:note>Free-text length string — not all source rows give a clean integer.</skos:note>
    </owl:DatatypeProperty>



    <!-- http://example.org/mvikg/ref -->


    <owl:DatatypeProperty rdf:about="http://example.org/mvikg/ref">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>reference allele</rdfs:label>
        <skos:definition>The reference allele reported at a given sequence position, prior to the observed variant.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Domain (biolink:SequenceVariant) is external — see mvikg-restrictions.ttl.</skos:note>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/base_coordinate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/base_coordinate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/sequence_localization_attribute"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>base coordinate</rdfs:label>
        <skos:altLabel>fully-closed</skos:altLabel>
        <skos:altLabel>one-based</skos:altLabel>
        <skos:definition>A position in the base coordinate system.  Base coordinates start at position 1 instead of position 0.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/category -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/category">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/type"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>category</rdfs:label>
        <skos:definition>Name of the high level ontology class in which this entity is categorized. Corresponds to the label for the biolink entity type class. In a neo4j database this MAY correspond to the neo4j label tag. In an RDF database it should be a biolink model class URI. This field is multi-valued. It should include values for ancestors of the biolink class; for example, a protein such as Shh would have category values `biolink:Protein`, `biolink:GeneProduct`, `biolink:MolecularEntity`. In an RDF database, nodes will typically have an rdf:type triples. This can be to the most specific biolink class, or potentially to a class more specific than something in biolink. For example, a sequence feature `f` may have a rdf:type assertion to a SO class such as TF_binding_site, which is more specific than anything in biolink. Here we would have categories {biolink:GenomicEntity, biolink:MolecularEntity, biolink:NamedThing}</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/description -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/description">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>description</rdfs:label>
        <skos:altLabel>definition</skos:altLabel>
        <skos:definition>a human-readable description of an entity</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <skos:exactMatch rdf:resource="http://www.w3.org/2004/02/skos/core#definitions"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <skos:narrowMatch rdf:resource="https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#Description"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/end_coordinate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/end_coordinate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/base_coordinate"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>end coordinate</rdfs:label>
        <skos:altLabel>end</skos:altLabel>
        <skos:closeMatch rdf:resource="http://biohackathon.org/resource/faldo#end"/>
        <skos:definition>The position at which the subject genomic entity ends on the chromosome or other entity to which it is located on.</skos:definition>
        <skos:exactMatch rdf:resource="https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#end"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/id -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/id">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>id</rdfs:label>
        <skos:definition>A unique identifier for an entity. Must be either a CURIE shorthand for a URI or a complete URI</skos:definition>
        <skos:exactMatch rdf:resource="https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#ID"/>
        <skos:exactMatch rdf:resource="https://github.com/geneontology/go-annotation/blob/master/specs/gpad-gpi-2-0.md#DB_Object_ID"/>
        <skos:exactMatch rdf:resource="https://www.alliancegenome.org/primaryId"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/publication_type -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/publication_type">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>publication type</rdfs:label>
        <skos:definition>Ontology term for publication type may be drawn from Dublin Core types (https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/), FRBR-aligned Bibliographic Ontology (https://sparontologies.github.io/fabio/current/fabio.html), the MESH publication types (https://www.nlm.nih.gov/mesh/pubtypes.html), the Confederation of Open Access Repositories (COAR) Controlled Vocabulary for Resource Type Genres (http://vocabularies.coar-repositories.org/documentation/resource_types/), Wikidata (https://www.wikidata.org/wiki/Wikidata:Publication_types), or equivalent publication type ontology. When a given publication type ontology term is used within a given knowledge graph, then the CURIE identified term must be documented in the graph as a concept node of biolink:category biolink:OntologyClass.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/published_in -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/published_in">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/sequence_localization_attribute -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/sequence_localization_attribute">
        <rdfs:label>sequence localization attribute</rdfs:label>
        <skos:definition>An attribute that can be applied to a genome sequence localization edge. These edges connect a nucleic acid entity such as an exon to an entity such as a chromosome. Edge properties are used to ascribe specific positional information and other metadata to the localization. In pragmatic terms this can be thought of as columns in a GFF3 line.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/start_coordinate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/start_coordinate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/base_coordinate"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>start coordinate</rdfs:label>
        <skos:altLabel>start</skos:altLabel>
        <skos:closeMatch rdf:resource="http://biohackathon.org/resource/faldo#begin"/>
        <skos:definition>The position at which the subject genomic entity starts on the chromosome or other entity to which it is located on. (ie: the start of the sequence being referenced is 1).</skos:definition>
        <skos:exactMatch rdf:resource="https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#start"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/biolink/vocab/type -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/biolink/vocab/type">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>type</rdfs:label>
        <skos:exactMatch rdf:resource="https://github.com/The-Sequence-Ontology/Specifications/blob/master/gff3.md#type"/>
        <skos:exactMatch rdf:resource="https://github.com/geneontology/go-annotation/blob/master/specs/gpad-gpi-2-0.md#DB_Object_Type"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:DatatypeProperty>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->





    <!-- http://example.org/mvikg/Biome -->


    <owl:Class rdf:about="http://example.org/mvikg/Biome">
        <rdfs:label>Biome</rdfs:label>
        <skos:definition>A biome classification describing a sample&apos;s environmental context, typically drawn from the GOLD biome vocabulary.</skos:definition>
        <skos:exactMatch rdf:resource="http://example.org/mvikg/Biome"/>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>We recommend any biome class from the GOLD ontology</skos:note>
    </owl:Class>



    <!-- http://example.org/mvikg/DevelopmentalStage -->


    <owl:Class rdf:about="http://example.org/mvikg/DevelopmentalStage">
        <rdfs:label>DevelopmentalStage</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.ebi.ac.uk/efo/EFO_0000399"/>
        <skos:definition>Represents a specific point or period in an organism&apos;s life cycle</skos:definition>
        <skos:exactMatch rdf:resource="http://example.org/mvikg/DevelopmentalStage"/>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>A developmental stage is a stage corresponding to a stage in bacteria&apos;s growth. e.g.: exponential, lag.</skos:note>
    </owl:Class>



    <!-- http://purl.obolibrary.org/obo/SO_0000001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0000110"/>
        <obo:IAO_0000115>A sequence_feature with an extent greater than zero. A nucleotide region is composed of bases and a polypeptide region is composed of amino acids.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>sequence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SO:0000001</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#SOFA"/>
        <rdfs:comment>A sequence_feature with an extent greater than zero. A nucleotide region is composed of bases and a polypeptide region is composed of amino acids.</rdfs:comment>
        <rdfs:label>region</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sequence_feature with an extent greater than zero. A nucleotide region is composed of bases and a polypeptide region is composed of amino acids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>



    <!-- http://purl.obolibrary.org/obo/SO_0000048 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000048">
        <obo:IAO_0000115>To substitute a subsection of sequence for another.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SO:0000048</oboInOwl:id>
        <rdfs:comment>To substitute a subsection of sequence for another.</rdfs:comment>
        <rdfs:label>substitute</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>To substitute a subsection of sequence for another.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>



    <!-- http://purl.obolibrary.org/obo/SO_0000110 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000110">
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/SO_0000400"/>
        <obo:IAO_0000115>Any extent of continuous biological sequence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>INSDC_feature:misc_feature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>INSDC_note:other</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>INSDC_note:sequence_feature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>located_sequence_feature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sequence feature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>located sequence feature</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>SO:0000110</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#SOFA"/>
        <rdfs:comment>Any extent of continuous biological sequence.</rdfs:comment>
        <rdfs:label>sequence_feature</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any extent of continuous biological sequence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>LAMHDI:mb</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>



    <!-- http://purl.obolibrary.org/obo/SO_0000159 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001059"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001411"/>
        <obo:IAO_0000115>The point at which one or more contiguous nucleotides were excised.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>SO:1000033</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Nucleotide_deletion</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>loinc:LA6692-3</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>deleted_sequence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleotide deletion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleotide_deletion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SO:0000159</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#SOFA"/>
        <rdfs:comment>The point at which one or more contiguous nucleotides were excised.</rdfs:comment>
        <rdfs:label>deletion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The point at which one or more contiguous nucleotides were excised.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://en.wikipedia.org/wiki/Nucleotide_deletion</owl:annotatedTarget>
        <rdfs:label>wiki</rdfs:label>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>loinc:LA6692-3</owl:annotatedTarget>
        <rdfs:label>Deletion</rdfs:label>
    </owl:Axiom>



    <!-- http://purl.obolibrary.org/obo/SO_0000400 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000400">
        <obo:IAO_0000115>An attribute describes a quality of sequence.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>sequence attribute</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SO:0000400</oboInOwl:id>
        <rdfs:comment>An attribute describes a quality of sequence.</rdfs:comment>
        <rdfs:label>sequence_attribute</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000400"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An attribute describes a quality of sequence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>



    <!-- http://purl.obolibrary.org/obo/SO_0000667 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001059"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001411"/>
        <obo:IAO_0000115>The sequence of one or more nucleotides added between two adjacent nucleotides in the sequence.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>SO:1000034</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>loinc:LA6687-3</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>insertion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleotide insertion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleotide_insertion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SO:0000667</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#DBVAR"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/so#SOFA"/>
        <rdfs:comment>The sequence of one or more nucleotides added between two adjacent nucleotides in the sequence.</rdfs:comment>
        <rdfs:label>insertion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000667"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The sequence of one or more nucleotides added between two adjacent nucleotides in the sequence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ke</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000667"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>loinc:LA6687-3</owl:annotatedTarget>
        <rdfs:label>Insertion</rdfs:label>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000667"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>insertion</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.ncbi.nlm.nih.gov/dbvar/</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/so#dbvar"/>
    </owl:Axiom>



    <!-- http://purl.obolibrary.org/obo/SO_0000694 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001483"/>
        <obo:IAO_0000115>SNPs are single base pair positions in genomic DNA at which different sequence alternatives exist in normal individuals in some population(s), wherein the least frequent variant has an abundance of 1% or greater.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>single nucleotide polymorphism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>sequence</oboInOwl:hasOBONamespace>
