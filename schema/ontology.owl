    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->





    <!-- http://example.org/mvikg/frequencyUnit -->


    <owl:ObjectProperty rdf:about="http://example.org/mvikg/frequencyUnit">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://qudt.org/vocab/unit/PERCENT"/>
                    <rdf:Description rdf:about="http://qudt.org/vocab/unit/UNITLESS"/>
                </owl:oneOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>frequency unit</rdfs:label>
        <skos:definition>The unit — percent or unitless — in which a sequence variant&apos;s mvikg:frequencyValue is expressed.</skos:definition>
    </owl:ObjectProperty>



    <!-- http://example.org/mvikg/has_biome_term -->


    <owl:ObjectProperty rdf:about="http://example.org/mvikg/has_biome_term">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/OrganismTaxon"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/mvikg/Biome"/>
        <rdfs:label>has_biome_term</rdfs:label>
        <skos:definition>Relates a sample or organism taxon to a resolved, curated biome term (typically from GOLD). Use mvikg:has_biome_text instead when the source text does not map to a controlled term.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Dual-predicate split of the former single-valued mvikg:has_biome, per the Case A (IRI-or-free-text) pattern.</skos:note>
    </owl:ObjectProperty>



    <!-- http://example.org/mvikg/has_developmental_stage -->


    <owl:ObjectProperty rdf:about="http://example.org/mvikg/has_developmental_stage">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:range rdf:resource="http://example.org/mvikg/DevelopmentalStage"/>
        <rdfs:label>has developmental stage</rdfs:label>
        <skos:definition>Relates a sample to the developmental stage (e.g. exponential, lag) of the organism it was taken from.</skos:definition>
        <skos:inScheme rdf:resource="http://example.org/mvikg/linkml"/>
        <skos:note>Domain (sosa:Sample) is external — see mvikg-restrictions.ttl. No inverse declared (same resolution as frequencyUnit).</skos:note>
    </owl:ObjectProperty>



    <!-- http://www.w3.org/2004/02/skos/core#broader -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader">
        <owl:inverseOf rdf:resource="http://www.w3.org/2004/02/skos/core#narrower"/>
        <vitro:descriptionAnnot>Public description modified from the information on this page: http://www.w3.org/TR/2005/WD-swbp-skos-core-guide-20050510/#sechierarchy .</vitro:descriptionAnnot>
        <rdfs:label xml:lang="en-us">broader term</rdfs:label>
    </owl:ObjectProperty>



    <!-- http://www.w3.org/2004/02/skos/core#narrower -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#narrower">
        <vitro:descriptionAnnot>Public description modified from the information on this page: http://www.w3.org/TR/2005/WD-swbp-skos-core-guide-20050510/#sechierarchy .</vitro:descriptionAnnot>
        <rdfs:label xml:lang="en-us">narrower term</rdfs:label>
    </owl:ObjectProperty>



    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/GenomicEntity"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">has feature of interest</rdfs:label>
        <skos:definition xml:lang="en">A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled.</skos:definition>
        <skos:example xml:lang="en">For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight.</skos:example>
    </owl:ObjectProperty>



    <!-- http://www.w3.org/ns/sosa/hasSample -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasSample">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isSampleOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/OrganismTaxon"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="en">Relation between a FeatureOfInterest and the Sample used to represent it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">has sample</rdfs:label>
        <skos:definition xml:lang="en">Relation between a FeatureOfInterest and the Sample used to represent it.</skos:definition>
    </owl:ObjectProperty>



    <!-- http://www.w3.org/ns/sosa/isFeatureOfInterestOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isFeatureOfInterestOf">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/GenomicEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is feature of interest of</rdfs:label>
        <skos:definition xml:lang="en">A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it.</skos:definition>
    </owl:ObjectProperty>



    <!-- http://www.w3.org/ns/sosa/isSampleOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isSampleOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/OrganismTaxon"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="en">Relation from a Sample to the FeatureOfInterest that it is intended to be representative of.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is sample of</rdfs:label>
        <skos:definition xml:lang="en">Relation from a Sample to the FeatureOfInterest that it is intended to be representative of.</skos:definition>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/has_evidence -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/has_evidence">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/PhenotypicFeature"/>
        <rdfs:range>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ECO_0000035"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ECO_0000305"/>
                </owl:oneOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>has evidence</rdfs:label>
        <skos:definition>Connects a phenotypic feature assertion to the type of evidence (ECO) supporting it.</skos:definition>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/has_phenotype -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/has_phenotype">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <owl:inverseOf rdf:resource="https://w3id.org/biolink/vocab/phenotype_of"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/Gene"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/GenomicEntity"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/SequenceVariant"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/PhenotypicFeature"/>
        <rdfs:label>has phenotype</rdfs:label>
        <skos:altLabel>disease presents symptom</skos:altLabel>
        <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_R108"/>
        <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_R115"/>
        <skos:definition>holds between a biological entity and a phenotype, where a phenotype is construed broadly as any kind of quality of an organism part, a collection of these qualities, or a change in quality or qualities (e.g. abnormally increased temperature). In SNOMEDCT, disorders with keyword &apos;characterized by&apos; should translate into this predicate.</skos:definition>
        <skos:editorialNote>check the range</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002200"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_R89"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0004022"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/doid#has_symptom"/>
        <vocab:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</vocab:canonical_predicate>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/has_sequence_variant -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/has_sequence_variant">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <owl:inverseOf rdf:resource="https://w3id.org/biolink/vocab/is_sequence_variant_of"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/GenomicEntity"/>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:label>has sequence variant</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/in_taxon -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/in_taxon">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <owl:inverseOf rdf:resource="https://w3id.org/biolink/vocab/taxon_of"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/ThingWithTaxon"/>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/OrganismTaxon"/>
        <rdfs:label>in taxon</rdfs:label>
        <skos:altLabel>gene found in organism</skos:altLabel>
        <skos:altLabel>gene product has organism source</skos:altLabel>
        <skos:altLabel>instance of</skos:altLabel>
        <skos:altLabel>is organism source of gene product</skos:altLabel>
        <skos:altLabel>organism has gene</skos:altLabel>
        <skos:definition>connects an entity to its taxonomic classification. Only certain kinds of entities can be taxonomically classified; see &apos;thing with taxon&apos;</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/prop/P703"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/RO_0002160"/>
        <vocab:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</vocab:canonical_predicate>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/is_sequence_variant_of -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/is_sequence_variant_of">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/SequenceVariant"/>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/GenomicEntity"/>
        <rdfs:label>is sequence variant of</rdfs:label>
        <skos:altLabel>allelic variant of</skos:altLabel>
        <skos:altLabel>gene product sequence variation encoded by gene mutant</skos:altLabel>
        <skos:altLabel>gene product variant of gene product</skos:altLabel>
        <skos:definition>holds between a sequence variant and a nucleic acid entity</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <skos:narrowMatch rdf:resource="https://www.wikidata.org/entity/P3433"/>
        <vocab:canonical_predicate rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</vocab:canonical_predicate>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/mentioned_by -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/mentioned_by">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <owl:inverseOf rdf:resource="https://w3id.org/biolink/vocab/mentions"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:range rdf:resource="https://w3id.org/biolink/vocab/Publication"/>
        <rdfs:label>mentioned by</rdfs:label>
        <skos:definition>refers to is a relation between one named thing and the information content entity that it makes reference to.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/mentions -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/mentions">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:label>mentions</rdfs:label>
        <skos:definition>refers to is a relation between one information content entity and the named thing that it makes reference to.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/IAO_0000142"/>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
        <skos:narrowMatch rdf:resource="http://semanticscience.org/resource/SIO_000628"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/node_property -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/node_property">
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/NamedThing"/>
        <rdfs:label>node property</rdfs:label>
        <skos:definition>A grouping for any property that holds between a node and a value</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/phenotype_of -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/phenotype_of">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/related_to_at_instance_level"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/PhenotypicFeature"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/Gene"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/GenomicEntity"/>
                    <rdf:Description rdf:about="https://w3id.org/biolink/vocab/SequenceVariant"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>phenotype of</rdfs:label>
        <skos:inScheme rdf:resource="https://w3id.org/biolink/biolink-model"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/biolink/vocab/published_in -->


    <owl:ObjectProperty rdf:about="https://w3id.org/biolink/vocab/published_in">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/biolink/vocab/node_property"/>
        <rdfs:domain rdf:resource="https://w3id.org/biolink/vocab/Publication"/>
    </owl:ObjectProperty>



